{
  "manifest_version": 3,
  "name": "Vertical Gallery Reader",
  "version": "1.1.0",
  "description": "Read galleries in a vertical scrolling layout.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://e-hentai.org/g/*"
      ],
      "js": [
        "src/adapters/registry.js",
        "src/core/settings.js",
        "src/core/progress.js",
        "src/core/reader.js",
        "src/adapters/ehentai.js",
        "src/content.js"
      ],
      "css": [
        "src/styles/reader.css",
        "src/styles/ehentai.css"
      ]
    }
  ]
}
