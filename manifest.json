{
    "manifest_version": 3,
    "name": "Vertical Gallery Reader",
    "version": "1.0.0",
    "description": "Read galleries in a vertical scrolling layout.",
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://e-hentai.org/g/*"
            ],
            "js": [
                "src/gallery.js",
                "src/imageLoader.js",
                "src/settings.js",
                "src/reader.js",
                "src/content.js"
            ],
            "css": [
                "src/reader.css"
            ]
        }
    ]
}